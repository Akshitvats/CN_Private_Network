# nginx edge site - reverse proxy, TLS termination and load balancer for @TEAM_DOMAIN@
# Role: @EDGE_NAME@ on @NODE_IP@
#
# Rendered by scripts/render-configs.sh from team/team.env into
# ~/cn-project/nginx/cn-project.conf on each edge. The primary edge
# (Mac 2, Krishna) and the standby edge (Mac 3, Akshit - Extension E) run
# this SAME file; only the X-Edge label differs.
#
# Phase 2 changes vs Phase 1 (nginx/cn-project.conf):
#   * health detection + retry so a dead backend is invisible (Extension D)
#   * port 80 now redirects to HTTPS instead of serving plain HTTP
#   * X-Edge header + /edge-health so we can SEE which edge answered (Ext E)
#   * access log records which backend served each request + retries

log_format cn_edge '$remote_addr [$time_local] "$request" status=$status '
                   'edge=@EDGE_NAME@ upstream=$upstream_addr '
                   'upstream_status=$upstream_status rt=$upstream_response_time';

upstream backend_pool {
    # Strategy: round-robin (A, B, A, B, ...).
    #
    # Health detection (Extension D). Open-source nginx uses PASSIVE checks:
    #  * a refused / timed-out connection counts as a failure;
    #  * after max_fails=1 failure the server is marked DOWN for
    #    fail_timeout=10s and gets no traffic;
    #  * after 10 s nginx tries it again with one real request - if that
    #    works, it rejoins the rotation automatically.
    server @BACKEND_A@ max_fails=1 fail_timeout=10s;   # Backend A (Mac 3, Akshit)
    server @BACKEND_B@ max_fails=1 fail_timeout=10s;   # Backend B (Mac 3, Akshit)
}

# Port 80: everything is redirected to HTTPS.
server {
    listen 80;
    server_name app.@TEAM_DOMAIN@ api.@TEAM_DOMAIN@;
    add_header X-Edge @EDGE_NAME@ always;
    return 301 https://$host$request_uri;
}

server {
    # "listen 443" with no address = wildcard bind, which macOS allows
    # without root. (Use 8443 if a Mac refuses 443.)
    listen 443 ssl;
    http2 on;
    server_name app.@TEAM_DOMAIN@ api.@TEAM_DOMAIN@;

    # mkcert certificate for app/api.@TEAM_DOMAIN@, signed by Krishna's local CA.
    # The SAME certificate + key are installed on both edges: TLS validates the
    # NAME, not the IP, so a DNS cutover to the standby edge is seamless.
    ssl_certificate     @CN_HOME@/tls/app.teamX.test.crt;
    ssl_certificate_key @CN_HOME@/tls/app.teamX.test.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:cn_tls:1m;

    access_log @CN_HOME@/logs/nginx-access.log cn_edge;
    error_log  @CN_HOME@/logs/nginx-error.log warn;

    # Which edge answered (Extension E evidence). Backend IPs are never
    # exposed to clients - they only appear in the edge's own log.
    add_header X-Edge @EDGE_NAME@ always;

    # Edge liveness check that does not touch the backends.
    location = /edge-health {
        default_type text/plain;
        return 200 "edge @EDGE_NAME@ ok\n";
    }

    location / {
        proxy_pass http://backend_pool;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Fail fast: a dead backend costs milliseconds, not seconds.
        proxy_connect_timeout 2s;
        proxy_read_timeout    10s;

        # If a backend refuses / times out / returns a gateway error, retry the
        # SAME request on the other backend, so the client never sees the error.
        proxy_next_upstream       error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;
    }
}
