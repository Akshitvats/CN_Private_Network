# Team network inventory - the SINGLE SOURCE OF TRUTH for every config.
#
# College Wi-Fi hands out addresses by DHCP, so the IPs change (e.g. every
# month, or whenever a laptop reconnects). At the start of EVERY session:
#   1. on each Mac:          scripts/get-my-ip.sh
#   2. on Satyam's Mac:      scripts/update-ips.sh mac2=<Krishna IP> mac3=<Akshit IP>
#                            (it detects Mac 1 itself, checks each Mac over SSH,
#                             rewrites the MACn_IP lines below and re-renders configs)
#   3. on Satyam's Mac:      scripts/deploy.sh
#
# Only the MACn_* lines hold real values; every role below is derived from them.
#
# Copy to team/team.env and put in TODAY's real addresses.

TEAM_DOMAIN=teamX.test

# ---- Machines -------------------------------------------------------------
# Mac 1 - Satyam Kumar (2401010428): PRIMARY DNS (dnsmasq) + test client + operator
MAC1_NAME=Satyam
MAC1_IP=192.168.1.21
MAC1_USER=satyamkumar
MAC1_HOST=Satyams-Macbook-Pro-2

# Mac 2 - Krishna Verma (2401010240): PRIMARY EDGE (nginx) + BACKUP DNS (dnsmasq)
MAC2_NAME=Krishna
MAC2_IP=192.168.1.22
MAC2_USER=krishnaverma
MAC2_HOST=Krishnas-MacBook-Pro-9

# Mac 3 - Akshit Vats (2401020085): Backend A :3001 + Backend B :3002
#         + STANDBY EDGE (nginx, Extension E) + backend firewall (pf, Extension C)
MAC3_NAME=Akshit
MAC3_IP=192.168.1.23
MAC3_USER=akshitvats
MAC3_HOST=Akshits-MacBook-Pro-3

# ---- Derived (do not edit) -------------------------------------------------
MAC1_SSH=$MAC1_USER@$MAC1_IP
MAC2_SSH=$MAC2_USER@$MAC2_IP
MAC3_SSH=$MAC3_USER@$MAC3_IP

DNS1_IP=$MAC1_IP          # primary resolver   (Mac 1)
DNS2_IP=$MAC2_IP          # backup resolver    (Mac 2)  - Extension A
EDGE1_IP=$MAC2_IP         # primary edge       (Mac 2)
EDGE2_IP=$MAC3_IP         # standby edge       (Mac 3)  - Extension E
BACKEND_A=$MAC3_IP:3001   # Backend A          (Mac 3)
BACKEND_B=$MAC3_IP:3002   # Backend B          (Mac 3)

# Where app.teamX.test / api.teamX.test point in normal operation
APP_RECORD_IP=$EDGE1_IP
# How each edge runs nginx: "root" (master as root via edge-root.sh - needed on
# Krishna's Mac, see scripts/phase2/edge-root.sh) or "user" (plain user process).
EDGE1_MODE=root
EDGE2_MODE=user

# TTL (seconds) clients may cache our DNS answers for - Extension B
DNS_TTL=30

# Resolvers dnsmasq forwards NON-project names to (college DNS, then Google),
# so normal Internet keeps working on clients that use the team DNS.
UPSTREAM_DNS="10.5.7.1 8.8.8.8"
