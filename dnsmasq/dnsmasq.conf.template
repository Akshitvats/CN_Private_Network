# dnsmasq - private DNS for @TEAM_DOMAIN@   (role: @DNS_ROLE@ resolver on @NODE_IP@)
#
# Rendered by scripts/render-configs.sh from team/team.env - do not edit the
# rendered copy, edit this template / team.env and re-render.
#
# The SAME file runs on the primary (Mac 1, Satyam) and on the backup
# (Mac 2, Krishna): both serve identical project records (Extension A).
#
# Phase 1 used "host-record=" lines in /opt/homebrew/etc/dnsmasq.conf and
# ran dnsmasq as root via brew services. Phase 2 keeps the records in a
# separate hosts file so they can be changed LIVE (Extensions B and E),
# and runs dnsmasq as the normal user from ~/cn-project (no sudo).

# ---- Listening -------------------------------------------------------------
# macOS lets an unprivileged process bind a port < 1024 only on the wildcard
# address, so we listen on 0.0.0.0:53 (UDP + TCP) - LAN and loopback.
port=53
bind-interfaces
listen-address=0.0.0.0

# ---- Project zone ----------------------------------------------------------
# Records live in teamX.hosts:  "<ip> app.@TEAM_DOMAIN@ api.@TEAM_DOMAIN@"
# Change it, send SIGHUP (cn.sh dns-record <ip>) and dnsmasq re-reads it and
# clears its cache immediately.
no-hosts
addn-hosts=@CN_HOME@/dnsmasq/teamX.hosts
# TTL clients may cache our answers for (Extension B).
local-ttl=@DNS_TTL@
# Authoritative for the project domain: unknown *.@TEAM_DOMAIN@ -> NXDOMAIN,
# never forwarded to the Internet.
local=/@TEAM_DOMAIN@/
# Reverse (PTR) answers for the team Macs. addn-hosts would otherwise answer
# "10.7.x.y -> app.@TEAM_DOMAIN@" for the edge IP, and a Mac that uses this DNS
# then renames itself "app.@TEAM_DOMAIN@" (macOS takes its hostname from
# reverse DNS). Explicit ptr-records win over the hosts file.
@PTR_RECORD_LINES@
domain-needed
bogus-priv

# ---- Everything else is forwarded upstream ---------------------------------
no-resolv
no-poll
@UPSTREAM_SERVER_LINES@

# ---- Operations ------------------------------------------------------------
log-queries
log-facility=@CN_HOME@/logs/dnsmasq.log
pid-file=@CN_HOME@/run/dnsmasq.pid
cache-size=1000
